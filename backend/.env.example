DATABASE_URL=mysql+pymysql://health_user:health_password@localhost:3306/health_system?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-long-random-secret

OPENAI_API_KEY=your_llm_api_key_here
OPENAI_API_BASE=https://api.deepseek.com
LLM_MODEL_DEFAULT=deepseek-v4-pro
LLM_MODEL_FAST=deepseek-chat
XHS_COOKIE=your_xhs_cookie_here
LLM_MODEL_SUMMARY=deepseek-chat

# RAG backend switch. Milvus medical-graphrag is the default production path.
RAG_BACKEND=medical_graphrag
MEDICAL_GRAPHRAG_API_BASE=http://localhost:8026/api/v1
# Required only when RAG_BACKEND=medical_graphrag.
MEDICAL_GRAPHRAG_API_TOKEN=
MEDICAL_GRAPHRAG_TIMEOUT_SECONDS=12

# Neo4j is used for entity/path explanation only. Milvus remains the evidence source.
NEO4J_URI=bolt://localhost:7714
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
RAG_GRAPHRAG_TIMEOUT_SECONDS=1.0
NEO4J_QUERY_TIMEOUT_SECONDS=1.0
